# MoodMix AI local settings
#
# Setup:
#   1. Copy this file to a new file named .env in the repository root:
#        cp .env.example .env
#   2. Open .env and put your Gemini API key after GEMINI_API_KEY= (no quotes, no spaces).
#   3. Never commit .env or share your key. Git already ignores .env (but not this example file).
#
# Notes:
#   - Variables already set in your shell take priority over values in .env.
#   - Leave a value empty to use the default. An empty GEMINI_API_KEY means "no key set".
#   - Loaded automatically by the MoodMix CLI and the Streamlit app.

# Required for real Gemini calls (get a key from Google AI Studio).
GEMINI_API_KEY=

# Optional: override the default Gemini model ID. The default, gemini-3.5-flash-lite, is the
# model used in the verified live run (docs/evidence/live_gemini_run_1.md). Leave empty to use it.
# Other model IDs may be retired or overloaded; check Google AI Studio for current ones.
GEMINI_MODEL=

# Advanced: you can also set GEMINI_TIMEOUT_S (1-300 seconds, default 45) in your shell or .env.
